# Fixed Make/compiler interface. No substitute source-language parser.
ROOT := $(abspath $(dir $(lastword $(MAKEFILE_LIST)))/../..)
CASES := $(ROOT)/qualification/icky-consumer
BUILD ?= $(CURDIR)/build/icky-consumer
ICK ?= gcc
HOST_CXX ?= c++
PARSER_ROOT ?= /missing-qualified-icky-package
PARSER_LIBS := $(PARSER_ROOT)/runtime/elf:$(PARSER_ROOT)/app/icky-parser_app
PARSER := env -i LD_LIBRARY_PATH=$(PARSER_LIBS) IDRIS2_INC_SRC=$(PARSER_ROOT)/app/icky-parser_app $(PARSER_ROOT)/runtime/elf/ld-linux-x86-64.so.2 --library-path $(PARSER_LIBS) $(PARSER_ROOT)/runtime/scheme -b $(PARSER_ROOT)/runtime/petite.boot -b $(PARSER_ROOT)/runtime/scheme.boot --program $(PARSER_ROOT)/app/icky-parser_app/icky-parser.so
OPTIONS := -ficky-parser-package=$(PARSER_ROOT)
LEVELS := O0 O2
REFUSALS := 2 3 4 5 6 7 8 9 10
.PHONY: all protocol $(addprefix run-,$(LEVELS)) $(addprefix refuse-,$(REFUSALS)) parser-refusals mutants
all: protocol $(addprefix run-,$(LEVELS)) $(addprefix refuse-,$(REFUSALS)) parser-refusals mutants remap-diagnostics
$(BUILD):
	mkdir -p "$@"
protocol: | $(BUILD)
	cp "$(CASES)/assignment.icky" "$(BUILD)/assignment.icky"
	truncate -s -1 "$(BUILD)/assignment.icky"
	$(PARSER) --parse-v3 "$(BUILD)/assignment.icky" > "$(BUILD)/protocol.tsv"
	$(HOST_CXX) -std=c++11 -Wall -Wextra -Werror -pedantic -O2 "$(ROOT)/examples/autogenerated/icky-compiler-consumer/protocol-test.cc" -o "$(BUILD)/protocol-test"
	"$(BUILD)/protocol-test" "$(BUILD)/assignment.icky" "$(BUILD)/protocol.tsv" > "$(BUILD)/protocol-tests.tsv"
define positive
run-$(1): | $(BUILD)
	timeout 60 "$(ICK)" $(OPTIONS) -ficky-receipt="$(BUILD)/$(1)-consumer.tsv" -std=c11 -Wall -Wextra -Werror -$(1) -c "$(CASES)/positive.c" -o "$(BUILD)/positive-$(1).o"
	"$(ICK)" -fno-link-libatomic "$(BUILD)/positive-$(1).o" -o "$(BUILD)/positive-$(1)"
	"$(BUILD)/positive-$(1)"
endef
$(foreach level,$(LEVELS),$(eval $(call positive,$(level))))
define negative
refuse-$(1): | $(BUILD)
	! timeout 30 "$(ICK)" $(OPTIONS) -DCASE=$(1) -c "$(CASES)/negative.c" -o "$(BUILD)/refuse-$(1).o" > "$(BUILD)/refuse-$(1).log" 2>&1
	test ! -e "$(BUILD)/refuse-$(1).o"
	grep -E 'ICKY_|read-only' "$(BUILD)/refuse-$(1).log"
endef
$(foreach case,$(REFUSALS),$(eval $(call negative,$(case))))
remap-diagnostics: refuse-9 refuse-10
	grep ICKY_EXPANSION_MAP "$(BUILD)/refuse-9.log"
	grep ICKY_EXPANSION_MAP "$(BUILD)/refuse-10.log"
parser-refusals: | $(BUILD)
	! timeout 30 "$(ICK)" -DCASE=1 -c "$(CASES)/negative.c" -o "$(BUILD)/missing.o" > "$(BUILD)/missing.log" 2>&1
	grep ICKY_PARSER_REQUIRED "$(BUILD)/missing.log"
	! timeout 30 "$(ICK)" -ficky-parser=/usr/bin/true -DCASE=1 -c "$(CASES)/negative.c" -o "$(BUILD)/noop.o" > "$(BUILD)/noop.log" 2>&1
	grep ICKY_PROTOCOL_BOUNDARY "$(BUILD)/noop.log"
	! timeout 30 "$(ICK)" -ficky-parser=/missing/icky-parser -DCASE=1 -c "$(CASES)/negative.c" -o "$(BUILD)/absent.o" > "$(BUILD)/absent.log" 2>&1
	grep ICKY_PARSER_EXECUTION "$(BUILD)/absent.log"
mutants: | $(BUILD)
	mkdir -p "$(BUILD)/mutants"
	printf '%s' 010 > "$(BUILD)/mutants/input.icky"
	$(PARSER) --parse-v3 "$(BUILD)/mutants/input.icky" > "$(BUILD)/mutants/golden.tsv"
	$(HOST_CXX) -std=c++11 -Wall -Wextra -Werror -pedantic -O2 "$(ROOT)/examples/autogenerated/icky-compiler-consumer/protocol-mutant.cc" -o "$(BUILD)/mutants/frame"
	cp "$(BUILD)/mutants/frame" "$(BUILD)/mutants/span"
	cp "$(BUILD)/mutants/frame" "$(BUILD)/mutants/truncated"
	cp "$(BUILD)/mutants/frame" "$(BUILD)/mutants/changed-map"
	! timeout 30 "$(ICK)" -ficky-parser="$(BUILD)/mutants/frame" -DCASE=1 -c "$(CASES)/negative.c" -o "$(BUILD)/frame.o" > "$(BUILD)/frame.log" 2>&1
	grep ICKY_SOURCE_FRAME "$(BUILD)/frame.log"
	! timeout 30 "$(ICK)" -ficky-parser="$(BUILD)/mutants/span" -DCASE=1 -c "$(CASES)/negative.c" -o "$(BUILD)/span.o" > "$(BUILD)/span.log" 2>&1
	grep ICKY_SOURCE_SPAN "$(BUILD)/span.log"
	! timeout 30 "$(ICK)" -ficky-parser="$(BUILD)/mutants/truncated" -DCASE=1 -c "$(CASES)/negative.c" -o "$(BUILD)/truncated.o" > "$(BUILD)/truncated.log" 2>&1
	grep ICKY_PROTOCOL_BOUNDARY "$(BUILD)/truncated.log"
	cp "$(CASES)/negative.c" "$(BUILD)/mutable.c"
	! timeout 30 "$(ICK)" -ficky-parser="$(BUILD)/mutants/changed-map" -DCASE=1 -c "$(BUILD)/mutable.c" -o "$(BUILD)/changed-map.o" > "$(BUILD)/changed-map.log" 2>&1
	grep ICKY_SOURCE_CHANGED "$(BUILD)/changed-map.log"
