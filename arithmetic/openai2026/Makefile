NUM_DEFINE_round-location := MUTANT_EARLY_ROUND
NUM_DEFINE_zero := MUTANT_ZERO
NUM_DEFINE_oracle-bypass := MUTANT_ORACLE_BYPASS
NUM_DEFINE_forced-exit := MUTANT_FORCE_EXIT
NUM_SOURCES_inverse-phase := $(NUM_SOURCES)
NUM_SOURCES_wrap := $(NUM_SOURCES)
NUM_SOURCES_lb-order := $(NUM_SOURCES)
NUM_SOURCES_one-product := $(NUM_PACKED_SOURCES)
NUM_SOURCES_r-m-scale := $(NUM_SOURCES)
NUM_SOURCES_round-location := $(NUM_PHASE_SOURCES)
NUM_SOURCES_zero := $(NUM_SOURCES)
NUM_SOURCES_oracle-bypass := $(NUM_SOURCES)
NUM_SOURCES_forced-exit := $(NUM_SOURCES)

