	ldd $(RESAMPLING_OUTPUT)/candidate > $(RESAMPLING_OUTPUT)/candidate.dependencies
	$(ICK_CC) --version > $(RESAMPLING_OUTPUT)/compiler-version.txt
	$(ORACLE_IDRIC) --version > $(RESAMPLING_OUTPUT)/oracle-compiler-version.txt

