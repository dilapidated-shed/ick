ICK_CC ?=
ORACLE_IDRIC ?=
CORPUS ?=
EXPECTED_CORPUS_SHA256 := 96e5ce0181dc92b269e444bc63c8f63684c56ad476474094b193ce4cd474f5f3
ORACLE_REVISION := 2734ac5a8
ROOT := $(abspath ../..)
GENERATED := $(ROOT)/examples/autogenerated/mul-1
OUTPUT := $(CURDIR)/build
FLAGS := -std=c11 -O2 -Wall -Wextra -Werror -I$(CURDIR)/include
SOURCES := src/limbs.c src/dyadic.c src/scalar_network.c tests/candidate.c
HEADERS := include/exact.h src/exact_internal.h
MUTANTS := wrong-side-sign omitted-undo dropped-carry zero oracle-bypass
DEFINE_wrong-side-sign := MUTANT_WRONG_SIDE_SIGN
DEFINE_omitted-undo := MUTANT_OMITTED_UNDO
DEFINE_dropped-carry := MUTANT_DROPPED_CARRY
DEFINE_zero := MUTANT_ZERO
DEFINE_oracle-bypass := MUTANT_ORACLE_BYPASS

.PHONY: identities check mutants clean
identities: | $(OUTPUT)
	$(ORACLE_IDRIC) --version
	$(ICK_CC) --version
	test "$(filter /%,$(ICK_CC))" = "$(ICK_CC)"
	test -n "$(ICK_CC)"
	test "$(filter /%,$(ORACLE_IDRIC))" = "$(ORACLE_IDRIC)"
	test -n "$(ORACLE_IDRIC)"
	$(ORACLE_IDRIC) --version | grep -F '$(ORACLE_REVISION)'
	test "$(filter /%,$(CORPUS))" = "$(CORPUS)"
	test -n "$(CORPUS)"
	sha256sum "$(CORPUS)" > $(OUTPUT)/whole-product-corpus.sha256
	grep -F '$(EXPECTED_CORPUS_SHA256)' $(OUTPUT)/whole-product-corpus.sha256

$(OUTPUT):
	mkdir -p $@

$(OUTPUT)/candidate: $(SOURCES) $(HEADERS) | $(OUTPUT)
	$(ICK_CC) $(FLAGS) $(SOURCES) -o $@

$(OUTPUT)/oracle: $(GENERATED)/Oracle.idr | $(OUTPUT)
	$(ORACLE_IDRIC) --cg chez --source-dir $(GENERATED) --output-dir $(OUTPUT) $< -o oracle

$(OUTPUT)/gate: $(GENERATED)/Gate.idr | $(OUTPUT)
	$(ORACLE_IDRIC) --cg chez --source-dir $(GENERATED) --output-dir $(OUTPUT) $< -o gate

$(OUTPUT)/runner: $(GENERATED)/Run.idr | $(OUTPUT)
	$(ORACLE_IDRIC) --cg chez --source-dir $(GENERATED) --output-dir $(OUTPUT) $< -o runner

$(OUTPUT)/scalar-v1.tsv: $(OUTPUT)/oracle
	$< > $@

check: $(OUTPUT) identities $(OUTPUT)/candidate $(OUTPUT)/scalar-v1.tsv $(OUTPUT)/gate $(OUTPUT)/runner
	$(OUTPUT)/runner one $(OUTPUT)/candidate $(OUTPUT)/scalar-v1.tsv $(OUTPUT)/gate $(OUTPUT)/candidate
	sha256sum $(SOURCES) $(HEADERS) $(GENERATED)/Oracle.idr $(OUTPUT)/candidate $(OUTPUT)/scalar-v1.tsv > $(OUTPUT)/identities.sha256
	grep -F 'cf36c5767db82ba4abb4d18be3ea871f24b7b470d34bb08abb7710cf6b62d074' $(OUTPUT)/identities.sha256
	$(ICK_CC) --version > $(OUTPUT)/compiler-version.txt
	$(ORACLE_IDRIC) --version > $(OUTPUT)/oracle-compiler-version.txt
	readelf -h $(OUTPUT)/candidate > $(OUTPUT)/candidate.elf-header
	objdump -d $(OUTPUT)/candidate > $(OUTPUT)/candidate.disassembly
	ldd $(OUTPUT)/candidate > $(OUTPUT)/candidate.dependencies

define mutant
$(OUTPUT)/$(1): $(SOURCES) $(HEADERS) | $(OUTPUT)
	$(ICK_CC) $(FLAGS) -D$(DEFINE_$(1)) $(SOURCES) -o $$@
endef
$(foreach name,$(MUTANTS),$(eval $(call mutant,$(name))))

mutants: check $(addprefix $(OUTPUT)/,$(MUTANTS))
	$(OUTPUT)/runner mutants $(OUTPUT) $(OUTPUT)/scalar-v1.tsv $(OUTPUT)/gate

clean:
	rm -rf $(OUTPUT)
