ICK_CC ?=
ORACLE_IDRIC ?=
CORPUS ?=
EXPECTED_CORPUS_SHA256 := 96e5ce0181dc92b269e444bc63c8f63684c56ad476474094b193ce4cd474f5f3
ORACLE_REVISION := 2734ac5a8
ROOT := $(abspath ../..)
GENERATED := $(ROOT)/examples/autogenerated/mul-1
OUTPUT := $(CURDIR)/build
FLAGS := -std=c11 -O2 -Wall -Wextra -Werror -I$(CURDIR)/include
SOURCES := src/limbs.c src/dyadic.c src/scalar_network.c tests/candidate.c
HEADERS := include/exact.h src/exact_internal.h
MUTANTS := wrong-side-sign omitted-undo dropped-carry zero oracle-bypass
DEFINE_wrong-side-sign := MUTANT_WRONG_SIDE_SIGN
DEFINE_omitted-undo := MUTANT_OMITTED_UNDO
DEFINE_dropped-carry := MUTANT_DROPPED_CARRY
DEFINE_zero := MUTANT_ZERO
DEFINE_oracle-bypass := MUTANT_ORACLE_BYPASS

.PHONY: identities check mutants clean
identities: | $(OUTPUT)
	$(ORACLE_IDRIC) --version
	$(ICK_CC) --version
	test "$(filter /%,$(ICK_CC))" = "$(ICK_CC)"
	test -n "$(ICK_CC)"
	test "$(filter /%,$(ORACLE_IDRIC))" = "$(ORACLE_IDRIC)"
	test -n "$(ORACLE_IDRIC)"
	$(ORACLE_IDRIC) --version | grep -F '$(ORACLE_REVISION)'
	test "$(filter /%,$(CORPUS))" = "$(CORPUS)"
	test -n "$(CORPUS)"
	sha256sum "$(CORPUS)" > $(OUTPUT)/whole-product-corpus.sha256
	grep -F '$(EXPECTED_CORPUS_SHA256)' $(OUTPUT)/whole-product-corpus.sha256

$(OUTPUT):
	mkdir -p $@

$(OUTPUT)/candidate: $(SOURCES) $(HEADERS) | $(OUTPUT)
	$(ICK_CC) $(FLAGS) $(SOURCES) -o $@

$(OUTPUT)/oracle: $(GENERATED)/Oracle.idr Makefile | $(OUTPUT)
	$(ORACLE_IDRIC) --cg chez --source-dir $(GENERATED) --build-dir $(OUTPUT)/idric-cache --output-dir $(OUTPUT) $< -o oracle

$(OUTPUT)/gate: $(GENERATED)/Gate.idr Makefile | $(OUTPUT)
	$(ORACLE_IDRIC) --cg chez --source-dir $(GENERATED) --build-dir $(OUTPUT)/idric-cache --output-dir $(OUTPUT) $< -o gate

$(OUTPUT)/runner: $(GENERATED)/Run.idr Makefile | $(OUTPUT)
	$(ORACLE_IDRIC) --cg chez --source-dir $(GENERATED) --build-dir $(OUTPUT)/idric-cache --output-dir $(OUTPUT) $< -o runner

$(OUTPUT)/scalar-v1.tsv: $(OUTPUT)/oracle
	$< > $@

check: $(OUTPUT) identities $(OUTPUT)/candidate $(OUTPUT)/scalar-v1.tsv $(OUTPUT)/gate $(OUTPUT)/runner
	$(OUTPUT)/runner one $(OUTPUT)/candidate $(OUTPUT)/scalar-v1.tsv $(OUTPUT)/gate $(OUTPUT)/candidate
	sha256sum $(SOURCES) $(HEADERS) $(GENERATED)/Oracle.idr $(OUTPUT)/candidate $(OUTPUT)/scalar-v1.tsv > $(OUTPUT)/identities.sha256
	grep -F 'cf36c5767db82ba4abb4d18be3ea871f24b7b470d34bb08abb7710cf6b62d074' $(OUTPUT)/identities.sha256
	$(ICK_CC) --version > $(OUTPUT)/compiler-version.txt
	$(ORACLE_IDRIC) --version > $(OUTPUT)/oracle-compiler-version.txt
	readelf -h $(OUTPUT)/candidate > $(OUTPUT)/candidate.elf-header
	objdump -d $(OUTPUT)/candidate > $(OUTPUT)/candidate.disassembly
	ldd $(OUTPUT)/candidate > $(OUTPUT)/candidate.dependencies

define mutant
$(OUTPUT)/$(1): $(SOURCES) $(HEADERS) | $(OUTPUT)
	$(ICK_CC) $(FLAGS) -D$(DEFINE_$(1)) $(SOURCES) -o $$@
endef
$(foreach name,$(MUTANTS),$(eval $(call mutant,$(name))))

mutants: check $(addprefix $(OUTPUT)/,$(MUTANTS))
	$(OUTPUT)/runner mutants $(OUTPUT) $(OUTPUT)/scalar-v1.tsv $(OUTPUT)/gate

RESAMPLING_GENERATED := $(ROOT)/examples/autogenerated/mul-4
RESAMPLING_OUTPUT := $(OUTPUT)/resampling
RESAMPLING_SOURCES := src/limbs.c src/dyadic.c src/directed_bounds.c src/certified_scalar.c src/resampling.c tests/resampling_candidate.c
RESAMPLING_HEADERS := include/exact.h include/error_bounds.h src/exact_internal.h src/certified_internal.h
RESAMPLING_MUTANTS := neumann-term reverse-dilation downward-tie relaxed-tail zero oracle-bypass
RESAMPLING_DEFINE_neumann-term := MUTANT_NEUMANN
RESAMPLING_DEFINE_reverse-dilation := MUTANT_DILATION
RESAMPLING_DEFINE_downward-tie := MUTANT_TIE
RESAMPLING_DEFINE_relaxed-tail := MUTANT_RELAXED_TAIL
RESAMPLING_DEFINE_zero := MUTANT_ZERO
RESAMPLING_DEFINE_oracle-bypass := MUTANT_ORACLE_BYPASS

.PHONY: check-resampling mutants-resampling
$(RESAMPLING_OUTPUT):
	mkdir -p $@

$(RESAMPLING_OUTPUT)/candidate: $(RESAMPLING_SOURCES) $(RESAMPLING_HEADERS) | $(RESAMPLING_OUTPUT)
	$(ICK_CC) $(FLAGS) -I$(CURDIR)/src $(RESAMPLING_SOURCES) -o $@

$(RESAMPLING_OUTPUT)/scalar-reference: $(RESAMPLING_GENERATED)/Reference.idr Makefile | $(RESAMPLING_OUTPUT)
	$(ORACLE_IDRIC) --cg chez --source-dir $(RESAMPLING_GENERATED) --build-dir $(RESAMPLING_OUTPUT)/idric-cache --output-dir $(RESAMPLING_OUTPUT) $< -o scalar-reference

$(RESAMPLING_OUTPUT)/line-reference: $(RESAMPLING_GENERATED)/LineReference.idr $(RESAMPLING_GENERATED)/Reference.idr Makefile | $(RESAMPLING_OUTPUT)
	$(ORACLE_IDRIC) --cg chez --source-dir $(RESAMPLING_GENERATED) --build-dir $(RESAMPLING_OUTPUT)/idric-cache --output-dir $(RESAMPLING_OUTPUT) $< -o line-reference

$(RESAMPLING_OUTPUT)/gate: $(RESAMPLING_GENERATED)/ResamplingGate.idr $(RESAMPLING_GENERATED)/ScalarGate.idr $(RESAMPLING_GENERATED)/Reference.idr Makefile | $(RESAMPLING_OUTPUT)
	$(ORACLE_IDRIC) --cg chez --source-dir $(RESAMPLING_GENERATED) --build-dir $(RESAMPLING_OUTPUT)/idric-cache --output-dir $(RESAMPLING_OUTPUT) $< -o gate

$(RESAMPLING_OUTPUT)/runner: $(RESAMPLING_GENERATED)/ResamplingRun.idr Makefile | $(RESAMPLING_OUTPUT)
	$(ORACLE_IDRIC) --cg chez --source-dir $(RESAMPLING_GENERATED) --build-dir $(RESAMPLING_OUTPUT)/idric-cache --output-dir $(RESAMPLING_OUTPUT) $< -o runner

$(RESAMPLING_OUTPUT)/scalar-reference.tsv: $(RESAMPLING_OUTPUT)/scalar-reference
	$< > $@

$(RESAMPLING_OUTPUT)/line-reference.tsv: $(RESAMPLING_OUTPUT)/line-reference
	$< > $@

$(RESAMPLING_OUTPUT)/resampling-v1.tsv: $(RESAMPLING_OUTPUT)/scalar-reference.tsv $(RESAMPLING_OUTPUT)/line-reference.tsv
	cat $^ > $@

check-resampling: identities $(RESAMPLING_OUTPUT)/candidate $(RESAMPLING_OUTPUT)/resampling-v1.tsv $(RESAMPLING_OUTPUT)/gate $(RESAMPLING_OUTPUT)/runner
	$(RESAMPLING_OUTPUT)/runner one $(RESAMPLING_OUTPUT)/candidate $(RESAMPLING_OUTPUT)/resampling-v1.tsv $(RESAMPLING_OUTPUT)/gate $(RESAMPLING_OUTPUT)/candidate
	sha256sum $(RESAMPLING_SOURCES) $(RESAMPLING_HEADERS) $(RESAMPLING_GENERATED)/*.idr $(RESAMPLING_OUTPUT)/candidate $(RESAMPLING_OUTPUT)/resampling-v1.tsv > $(RESAMPLING_OUTPUT)/identities.sha256
	grep -F '05b0b142bacd634f77c3edfc1179ef7ab58c6f65b6eeca9c41559d9222a3251c' $(RESAMPLING_OUTPUT)/identities.sha256
	readelf -h $(RESAMPLING_OUTPUT)/candidate > $(RESAMPLING_OUTPUT)/candidate.elf-header
	objdump -d $(RESAMPLING_OUTPUT)/candidate > $(RESAMPLING_OUTPUT)/candidate.disassembly
	ldd $(RESAMPLING_OUTPUT)/candidate > $(RESAMPLING_OUTPUT)/candidate.dependencies
	$(ICK_CC) --version > $(RESAMPLING_OUTPUT)/compiler-version.txt
	$(ORACLE_IDRIC) --version > $(RESAMPLING_OUTPUT)/oracle-compiler-version.txt

define resampling-mutant
$(RESAMPLING_OUTPUT)/$(1): $(RESAMPLING_SOURCES) $(RESAMPLING_HEADERS) | $(RESAMPLING_OUTPUT)
	$(ICK_CC) $(FLAGS) -I$(CURDIR)/src -D$(RESAMPLING_DEFINE_$(1)) $(RESAMPLING_SOURCES) -o $$@
endef
$(foreach name,$(RESAMPLING_MUTANTS),$(eval $(call resampling-mutant,$(name))))

mutants-resampling: check-resampling $(addprefix $(RESAMPLING_OUTPUT)/,$(RESAMPLING_MUTANTS))
	$(RESAMPLING_OUTPUT)/runner mutants $(RESAMPLING_OUTPUT) $(RESAMPLING_OUTPUT)/resampling-v1.tsv $(RESAMPLING_OUTPUT)/gate

clean:
	rm -rf $(OUTPUT)
