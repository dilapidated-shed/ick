ICK_CC ?=
ORACLE_IDRIC ?=
CORPUS ?=
EXPECTED_CORPUS_SHA256 := 96e5ce0181dc92b269e444bc63c8f63684c56ad476474094b193ce4cd474f5f3
ORACLE_REVISION := 081b9cde0
ROOT := $(abspath ../..)
GENERATED := $(ROOT)/examples/autogenerated/mul-1
OUTPUT := $(CURDIR)/build
FLAGS := -std=c11 -O2 -Wall -Wextra -Werror -I$(CURDIR)/include
SOURCES := src/limbs.c src/dyadic.c src/scalar_network.c tests/candidate.c
HEADERS := include/exact.h src/exact_internal.h
MUTANTS := wrong-side-sign omitted-undo dropped-carry zero oracle-bypass
DEFINE_wrong-side-sign := MUTANT_WRONG_SIDE_SIGN
DEFINE_omitted-undo := MUTANT_OMITTED_UNDO
DEFINE_dropped-carry := MUTANT_DROPPED_CARRY
DEFINE_zero := MUTANT_ZERO
DEFINE_oracle-bypass := MUTANT_ORACLE_BYPASS

.PHONY: identities check mutants clean
identities: | $(OUTPUT)
	$(ORACLE_IDRIC) --version
	$(ICK_CC) --version
	test "$(filter /%,$(ICK_CC))" = "$(ICK_CC)"
	test -n "$(ICK_CC)"
	test "$(filter /%,$(ORACLE_IDRIC))" = "$(ORACLE_IDRIC)"
	test -n "$(ORACLE_IDRIC)"
	$(ORACLE_IDRIC) --version | grep -F '$(ORACLE_REVISION)'
	test "$(filter /%,$(CORPUS))" = "$(CORPUS)"
	test -n "$(CORPUS)"
	sha256sum "$(CORPUS)" > $(OUTPUT)/whole-product-corpus.sha256
	grep -F '$(EXPECTED_CORPUS_SHA256)' $(OUTPUT)/whole-product-corpus.sha256

$(OUTPUT):
	mkdir -p $@

$(OUTPUT)/candidate: $(SOURCES) $(HEADERS) | $(OUTPUT)
	$(ICK_CC) $(FLAGS) $(SOURCES) -o $@

$(OUTPUT)/oracle: $(GENERATED)/Oracle.idr Makefile | $(OUTPUT)
	$(ORACLE_IDRIC) --cg chez --source-dir $(GENERATED) --build-dir $(OUTPUT)/idric-cache --output-dir $(OUTPUT) $< -o oracle

$(OUTPUT)/gate: $(GENERATED)/Gate.idr Makefile | $(OUTPUT)
	$(ORACLE_IDRIC) --cg chez --source-dir $(GENERATED) --build-dir $(OUTPUT)/idric-cache --output-dir $(OUTPUT) $< -o gate

$(OUTPUT)/runner: $(GENERATED)/Run.idr Makefile | $(OUTPUT)
	$(ORACLE_IDRIC) --cg chez --source-dir $(GENERATED) --build-dir $(OUTPUT)/idric-cache --output-dir $(OUTPUT) $< -o runner

$(OUTPUT)/scalar-v1.tsv: $(OUTPUT)/oracle
	$< > $@

check: $(OUTPUT) identities $(OUTPUT)/candidate $(OUTPUT)/scalar-v1.tsv $(OUTPUT)/gate $(OUTPUT)/runner
	$(OUTPUT)/runner one $(OUTPUT)/candidate $(OUTPUT)/scalar-v1.tsv $(OUTPUT)/gate $(OUTPUT)/candidate
	sha256sum $(SOURCES) $(HEADERS) $(GENERATED)/Oracle.idr $(OUTPUT)/candidate $(OUTPUT)/scalar-v1.tsv > $(OUTPUT)/identities.sha256
	grep -F 'cf36c5767db82ba4abb4d18be3ea871f24b7b470d34bb08abb7710cf6b62d074' $(OUTPUT)/identities.sha256
	$(ICK_CC) --version > $(OUTPUT)/compiler-version.txt
	$(ORACLE_IDRIC) --version > $(OUTPUT)/oracle-compiler-version.txt
	readelf -h $(OUTPUT)/candidate > $(OUTPUT)/candidate.elf-header
	objdump -d $(OUTPUT)/candidate > $(OUTPUT)/candidate.disassembly
	ldd $(OUTPUT)/candidate > $(OUTPUT)/candidate.dependencies

define mutant
$(OUTPUT)/$(1): $(SOURCES) $(HEADERS) | $(OUTPUT)
	$(ICK_CC) $(FLAGS) -D$(DEFINE_$(1)) $(SOURCES) -o $$@
endef
$(foreach name,$(MUTANTS),$(eval $(call mutant,$(name))))

mutants: check $(addprefix $(OUTPUT)/,$(MUTANTS))
	$(OUTPUT)/runner mutants $(OUTPUT) $(OUTPUT)/scalar-v1.tsv $(OUTPUT)/gate

LAYOUT_GENERATED := $(ROOT)/examples/autogenerated/mul-2
LAYOUT_OUTPUT := $(OUTPUT)/layouts
FRAME_SOURCES := src/limbs.c src/dyadic.c src/frames.c src/framed_network.c src/framed_bits.c tests/frames_candidate.c
PACKED_SOURCES := src/limbs.c src/streams.c src/shear.c src/packed_bits.c tests/layout_candidate.c
LAYOUT_HEADERS := include/exact.h include/network.h include/layout.h src/exact_internal.h
LAYOUT_MUTANTS := endpoint-sign source-rank auxiliary-frame inverse-order omitted-correction
LAYOUT_DEFINE_endpoint-sign := MUTANT_ENDPOINT_SIGN
LAYOUT_DEFINE_source-rank := MUTANT_SOURCE_RANK
LAYOUT_DEFINE_auxiliary-frame := MUTANT_AUXILIARY_FRAME
LAYOUT_DEFINE_inverse-order := MUTANT_INVERSE_ORDER
LAYOUT_DEFINE_omitted-correction := MUTANT_OMITTED_CORRECTION
LAYOUT_SOURCES_endpoint-sign := $(FRAME_SOURCES)
LAYOUT_SOURCES_source-rank := $(FRAME_SOURCES)
LAYOUT_SOURCES_auxiliary-frame := $(FRAME_SOURCES)
LAYOUT_SOURCES_inverse-order := $(PACKED_SOURCES)
LAYOUT_SOURCES_omitted-correction := $(PACKED_SOURCES)

.PHONY: check-layouts mutants-layouts
$(LAYOUT_OUTPUT):
	mkdir -p $@

$(LAYOUT_OUTPUT)/frames-candidate: $(FRAME_SOURCES) $(LAYOUT_HEADERS) | $(LAYOUT_OUTPUT)
	$(ICK_CC) $(FLAGS) $(FRAME_SOURCES) -o $@

$(LAYOUT_OUTPUT)/packed-candidate: $(PACKED_SOURCES) $(LAYOUT_HEADERS) | $(LAYOUT_OUTPUT)
	$(ICK_CC) $(FLAGS) $(PACKED_SOURCES) -o $@

$(LAYOUT_OUTPUT)/network-generator: $(LAYOUT_GENERATED)/NetworkGenerator.idr Makefile | $(LAYOUT_OUTPUT)
	$(ORACLE_IDRIC) --cg chez --source-dir $(LAYOUT_GENERATED) --build-dir $(LAYOUT_OUTPUT)/idric-cache --output-dir $(LAYOUT_OUTPUT) $< -o network-generator

$(LAYOUT_OUTPUT)/packed-oracle: $(LAYOUT_GENERATED)/LayoutOracle.idr Makefile | $(LAYOUT_OUTPUT)
	$(ORACLE_IDRIC) --cg chez --source-dir $(LAYOUT_GENERATED) --build-dir $(LAYOUT_OUTPUT)/idric-cache --output-dir $(LAYOUT_OUTPUT) $< -o packed-oracle

$(LAYOUT_OUTPUT)/gate: $(LAYOUT_GENERATED)/LayoutGate.idr Makefile | $(LAYOUT_OUTPUT)
	$(ORACLE_IDRIC) --cg chez --source-dir $(LAYOUT_GENERATED) --build-dir $(LAYOUT_OUTPUT)/idric-cache --output-dir $(LAYOUT_OUTPUT) $< -o gate

$(LAYOUT_OUTPUT)/runner: $(LAYOUT_GENERATED)/LayoutRun.idr Makefile | $(LAYOUT_OUTPUT)
	$(ORACLE_IDRIC) --cg chez --source-dir $(LAYOUT_GENERATED) --build-dir $(LAYOUT_OUTPUT)/idric-cache --output-dir $(LAYOUT_OUTPUT) $< -o runner

$(LAYOUT_OUTPUT)/operator-oracle: $(LAYOUT_GENERATED)/OperatorOracle.idr Makefile | $(LAYOUT_OUTPUT)
	$(ORACLE_IDRIC) --cg chez --source-dir $(LAYOUT_GENERATED) --build-dir $(LAYOUT_OUTPUT)/idric-cache --output-dir $(LAYOUT_OUTPUT) $< -o operator-oracle

$(LAYOUT_OUTPUT)/bit-oracle: $(LAYOUT_GENERATED)/BitOracle.idr Makefile | $(LAYOUT_OUTPUT)
	$(ORACLE_IDRIC) --cg chez --source-dir $(LAYOUT_GENERATED) --build-dir $(LAYOUT_OUTPUT)/idric-cache --output-dir $(LAYOUT_OUTPUT) $< -o bit-oracle

$(LAYOUT_OUTPUT)/bit-operators.tsv: $(LAYOUT_OUTPUT)/bit-oracle
	$< > $@

$(LAYOUT_OUTPUT)/frames-descriptors.tsv: $(LAYOUT_OUTPUT)/network-generator
	$< > $@

$(LAYOUT_OUTPUT)/phase-operators.tsv: $(LAYOUT_OUTPUT)/operator-oracle
	$< > $@

$(LAYOUT_OUTPUT)/frames-v1.tsv: $(LAYOUT_OUTPUT)/frames-descriptors.tsv $(LAYOUT_OUTPUT)/phase-operators.tsv $(LAYOUT_OUTPUT)/bit-operators.tsv
	cat $^ > $@

$(LAYOUT_OUTPUT)/packed-v1.tsv: $(LAYOUT_OUTPUT)/packed-oracle
	$< > $@

check-layouts: identities $(LAYOUT_OUTPUT)/frames-candidate $(LAYOUT_OUTPUT)/packed-candidate $(LAYOUT_OUTPUT)/frames-v1.tsv $(LAYOUT_OUTPUT)/packed-v1.tsv $(LAYOUT_OUTPUT)/gate $(LAYOUT_OUTPUT)/runner
	$(LAYOUT_OUTPUT)/runner one frames $(LAYOUT_OUTPUT)/frames-candidate $(LAYOUT_OUTPUT)/frames-v1.tsv $(LAYOUT_OUTPUT)/gate $(LAYOUT_OUTPUT)/frames-candidate
	$(LAYOUT_OUTPUT)/runner one packed $(LAYOUT_OUTPUT)/packed-candidate $(LAYOUT_OUTPUT)/packed-v1.tsv $(LAYOUT_OUTPUT)/gate $(LAYOUT_OUTPUT)/packed-candidate
	sha256sum $(FRAME_SOURCES) $(PACKED_SOURCES) $(LAYOUT_HEADERS) $(LAYOUT_GENERATED)/*.idr $(LAYOUT_OUTPUT)/frames-candidate $(LAYOUT_OUTPUT)/packed-candidate $(LAYOUT_OUTPUT)/*-v1.tsv $(LAYOUT_OUTPUT)/frames-descriptors.tsv > $(LAYOUT_OUTPUT)/identities.sha256
	grep -F 'e961dabdffc722a3dbc67eacc50231c54b06dd0b8faa7977d191202e76e8d805' $(LAYOUT_OUTPUT)/identities.sha256
	grep -F '5b09471f8f6c87545e9b2cf29ee9df70d94a6cf541ad47ee9b4b6fb5988f605d' $(LAYOUT_OUTPUT)/identities.sha256
	grep -F 'e8122ceb18f1b47b06b357c3c131db939fb87c4aa3bf26fa020c120ff0f4801d' $(LAYOUT_OUTPUT)/identities.sha256
	readelf -h $(LAYOUT_OUTPUT)/frames-candidate > $(LAYOUT_OUTPUT)/frames-candidate.elf-header
	readelf -h $(LAYOUT_OUTPUT)/packed-candidate > $(LAYOUT_OUTPUT)/packed-candidate.elf-header
	objdump -d $(LAYOUT_OUTPUT)/frames-candidate > $(LAYOUT_OUTPUT)/frames-candidate.disassembly
	objdump -d $(LAYOUT_OUTPUT)/packed-candidate > $(LAYOUT_OUTPUT)/packed-candidate.disassembly
	$(ICK_CC) --version > $(LAYOUT_OUTPUT)/compiler-version.txt
	$(ORACLE_IDRIC) --version > $(LAYOUT_OUTPUT)/oracle-compiler-version.txt

define layout-mutant
$(LAYOUT_OUTPUT)/$(1): $(LAYOUT_SOURCES_$(1)) $(LAYOUT_HEADERS) | $(LAYOUT_OUTPUT)
	$(ICK_CC) $(FLAGS) -D$(LAYOUT_DEFINE_$(1)) $(LAYOUT_SOURCES_$(1)) -o $$@
endef
$(foreach name,$(LAYOUT_MUTANTS),$(eval $(call layout-mutant,$(name))))

mutants-layouts: check-layouts $(addprefix $(LAYOUT_OUTPUT)/,$(LAYOUT_MUTANTS))
	$(LAYOUT_OUTPUT)/runner mutants $(LAYOUT_OUTPUT) $(LAYOUT_OUTPUT)/gate

clean:
	rm -rf $(OUTPUT)
