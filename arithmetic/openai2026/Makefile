NUM_OUTPUT := $(OUTPUT)/numerical
NUM_CORE := src/limbs.c src/dyadic.c src/frames.c src/framed_network.c src/phase_layer.c src/phase_child.c src/synthetic_transform.c src/packed_product.c src/convolution.c
NUM_HEADERS := $(LAYOUT_HEADERS) include/numerical.h src/numerical_internal.h
NUM_SOURCES := $(NUM_CORE) tests/numerical_candidate.c
NUM_PHASE_SOURCES := src/limbs.c src/dyadic.c src/frames.c src/framed_network.c src/phase_layer.c src/packed_product.c tests/phase_candidate.c
NUM_PACKED_SOURCES := src/limbs.c src/dyadic.c src/packed_product.c tests/packed_candidate.c
NUM_MUTANTS := inverse-phase wrap lb-order one-product r-m-scale round-location zero oracle-bypass forced-exit
NUM_DEFINE_inverse-phase := MUTANT_INVERSE_PHASE
NUM_DEFINE_wrap := MUTANT_WRAP
NUM_DEFINE_lb-order := MUTANT_LB
NUM_DEFINE_one-product := MUTANT_ONE_PRODUCT
